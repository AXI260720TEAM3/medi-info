DB_USER=medinfo
DB_PASS=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medinfo
# 내 Ubuntu의 Ollama (기본). GPU가 없으면 ZeroTier로 모델 서버 PC: http://10.114.246.156:11434
OLLAMA_URL=http://host.docker.internal:11434
# 약봉지 사진 읽기 모델. 비워 두면 qwen2.5vl:7b (OLLAMA_URL의 Ollama에 받아 둬야 해요: ollama pull qwen2.5vl:7b)
VISION_MODEL=
DATA_GO_KR_KEY=
JWT_SECRET=
# 비워 두면 인증번호가 서버 로그에 나와요
SMTP_USER=
SMTP_PASS=
# (선택, k8s) Tailscale Funnel 주소. 있으면 k8s/deploy.sh가 이 주소로도 받아요. 예: 기기이름.tailXXXX.ts.net
FUNNEL_HOST=
# (선택, k8s) 1이면 관리자 화면을 Funnel 주소에서도 열어요(인터넷 공개). 다른 기기로 발표하는 날만, 끝나면 지우고 다시 배포
ADMIN_ON_FUNNEL=
